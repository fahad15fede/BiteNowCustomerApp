# ─────────────────────────────────────────────
# BiteNow customer app: environment settings
# Copy this file to .env and fill in your values.
# Restart Expo after changing .env.
#
# ⚠️ Everything starting with EXPO_PUBLIC_ is built INTO the app
#    and can be read by anyone. NEVER put secrets here.
# ─────────────────────────────────────────────

# Backend API base URL (must end with /api/v1)
#
#   Real phone (Expo Go, same Wi-Fi):  http:// 192.168.18.208:8000/api/v1
#   Android emulator:                  http://10.0.2.2:8000/api/v1
#   Expo web (browser on laptop):      http://localhost:8000/api/v1
#
# Find your laptop IP with `ipconfig` → "Wireless LAN adapter Wi-Fi" → IPv4 Address
EXPO_PUBLIC_API_URL=http://192.168.18.208:8000/api/v1